model User {
    id                Int              @id @default(autoincrement())
    email             String           @unique
    name              String
    password          String
    sessions          Session[]
    campaignsAsPlayer CampaignPlayer[]
    campaignsAsGM     Campaign[]
    createdAt         DateTime         @default(now())
    updatedAt         DateTime         @default(now()) @updatedAt
}
